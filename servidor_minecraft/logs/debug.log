    "1.6.2.1": "Adds missing crafting table to Mountain Moderate House"
  },
  "1.16.4": {
    "1.6.4.0": "Initial release for 1.16.4 containing the latest updates from 1.6.2.1",
    "1.6.4.1": "Adding Creative Bulldozer",
    "1.6.4.2": "Fixed recipes to use Minecraft Tag system (old OreDictionary)",
    "1.6.4.3": "Added visual indicator of clicked block in preview and shortcut to preview to build structure"
  },
  "1.16.5": {
    "1.6.5.0": "Initial release for 1.16.5 containing the latest updates from 1.6.4.3",
    "1.6.5.1": "Fixing issue with glass panes in structures. Removed wither rose from Tree Nether Gate. Fixed default config file loading",
    "1.6.5.2": "Fixing issue where the player could generate infinite houses without losing blueprint",
    "1.6.5.3": "Adding Advanced Aqua Base and Sugar Cane Farm. Aqua Base recipe updated as it was too cheap before",
    "1.6.5.4": "Fixed item frames in structures, made workshop blueprint. Lots of config updates, see full changelog on CurseForge",
    "1.6.5.5": "Fixed issue with the workshop where it would not generate the mineshaft. Added Ukrainian language file",
    "1.6.5.6": "Added Clear glass options to some blueprints, added Sandstone and Red Sandstone to Structure Part and Instant Bridge. Fixed more Internationalization issues",
    "1.6.5.7": "Re-vamped all blueprint screens, fixed some translations, added second Acacia style house to Moderate House item, added modern buildings",
    "1.6.5.8": "Added many new items and blocks such as Swift Blades and Dirt Walls. Also added more buildings for the Modern Buildings item",
    "1.6.5.9": "Fixed infinite blueprints, fixed water in nether, fixed swift blades, updated textures, added campsite starter house",
    "1.6.5.10": "Updated compressed chest texture, added beds to villager houses, added modern tree house, add custom creative tab",
    "1.6.5.11": "Agriculture update: Added tiered farms, many new and interesting types of farms. Consolidated items. See changelog on CurseForge for more details",
    "1.6.5.12": "Fixing campsite house error, adding lights to modern tree house, fixing some reversal recipes",
    "1.6.5.13": "Instant build, build generation soud, updated checkboxes, machinery tower glass color and more! See Curseforge for full changelog",
    "1.6.5.14": "Fixed spawners and the sign on the monster masher",
    "1.6.5.15": "Added configuration option for the building sound. Fixed lecterns for the town hall. Fixed various entity generation. Fixed the bulldozer for survival mode",
    "1.6.5.16": "Added Finnish and German translations. Updated structure item textures to be up to modern styling. A number of other fixes and enhancements."
  },
  "1.17.1": {
    "1.7.1.0": "Initial release for 1.17.1 containing the latest updates from 1.6.5.11",
    "1.7.1.1": "Fixing campsite house error, adding lights to modern tree house, fixing some reversal recipes",
    "1.7.1.2": "Added configuration to determine if the building sound would play. Fixed lecturns for the town hall. Fixed various entity generation issues. Fixed the bulldozer for survival mode"
  },
  "1.18.1": {
    "1.8.1.0": "Initial release for 1.18.1 containing the latest updates from 1.7.1.2",
    "1.8.1.1": "Adding Quartz-Crete blocks (so many types....), adding restaurant and juice shop, adding modern moderate housee",
    "1.8.1.2": "Fixing item frame and painting placement. Fixing crash on dedicated server when previewing structures",
    "1.8.1.3": "Fixed issue with certain buildings generating with paintings",
    "1.8.1.4": "Added Izba starting house. Fixed Grass Wall Block connections"
  },
  "1.18.2": {
    "1.8.2.0": "Initial release for 1.18.2 containing the latest updates from 1.8.1.4",
    "1.8.2.1": "Added new starter house options, added new moderate house options, added moderate barn option, fixed bug causing players to lose structure items",
    "1.8.2.2": "Fixed issue where the moderate barn was made instead of the advanced barn"
  },
  "1.19.2": {
    "1.9.2.0": "Initial release for 1.18.2 containing the latest updates from 1.8.2.2. Also lots of new buildings and options!",
    "1.9.2.1": "Fixed some issues with dedicated servers",
    "1.9.2.2": "Fixed more issues with dedicated servers, sorry about these!!!!",
    "1.9.2.3": "Added Estate, Dark WatchTower, New Monster Masher, New Dark-Light Block and Light Switch",
    "1.9.2.4": "Glass option for instant bridge, clearer starting item config option, German translations!",
    "1.9.2.5": "Fixed issue with the mineshaft entrance not generating the mineshaft"
  },
  "1.19.3": {
    "1.9.3.0": "Initial release for 1.19.3. Added Finnish language"
  },
  "1.20.1": {
    "1.10.0.0": "Initial release for 1.20.1."
  },
  "1.20.6": {
    "2.0.0.0": "Initial release for 1.20.6.",
    "2.0.0.1": "Fixing shaped recipes, they just didn't work, don't ask how we didn't see that",
    "2.0.0.2": "Fixing issue with connecting to servers with disabled recipes"
  }
}
